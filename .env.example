# Copy to .env; Taskfile and docker compose load it automatically.
# Host port for the compose Postgres; change it (and DATABASE_URL) if 5432 is taken.
POSTGRES_PORT=5432
# Host ports for docker compose (API + dashboard, Prometheus with --profile monitoring).
API_PORT=8080
PROMETHEUS_PORT=9091
DATABASE_URL=postgres://forgeq:forgeq@localhost:5432/forgeq?sslmode=disable
# pgx pool size per process; replicas x (pool + 1) + api pool must fit max_connections.
DB_MAX_CONNS=10
LOG_LEVEL=info
LOG_FORMAT=text

# API
HTTP_ADDR=:8080
# Protects all of /api/v1 (Bearer) and the dashboard (basic auth). Leave empty to disable auth (development only).
API_KEY=

# Worker
OPS_ADDR=:9090
WORKER_QUEUES=default:10,emails:5,reports:2,bench:10
POLL_INTERVAL=1s
LEASE_DURATION=30s
HEARTBEAT_INTERVAL=10s
REAPER_INTERVAL=15s
JOB_RETENTION=7d
DEFAULT_JOB_TIMEOUT=30s
SHUTDOWN_TIMEOUT=25s
BACKOFF_BASE=2s
BACKOFF_MAX=1h
BACKOFF_JITTER=1s
DEMO_FAIL_RATE=0.2
